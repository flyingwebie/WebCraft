# Copy to .env (git ignores it). Bun loads .env from the directory it runs in, so run every
# command from the repo root. See docs/development.md.

# The Install's Postgres database. `bun run dev` starts docker-compose.dev.yml when nothing answers
# here and the host is this machine. Tests create and drop databases named after this one, so give
# each worktree its own name (see docs/development.md).
DATABASE_URL=postgres://postgres:webcraft@localhost:5432/webcraft

# The admin's hostname: the admin, /healthz and /readyz answer here; every other hostname is a Site.
# Names under .localhost reach this machine without any DNS setup.
WEBCRAFT_ADMIN_HOST=admin.localhost

# Optional: the domain Staging addresses sit under. Each Site answers on <site slug>.<this domain>,
# so with sites.localhost a Site with the slug bakery is http://bakery.sites.localhost:3000/.
WEBCRAFT_SITES_DOMAIN=sites.localhost

# Optional: what answers HTTPS for the Install: caddy (the default, on a VPS), coolify or railway.
# WEBCRAFT_EDGE=caddy

# Optional: the Install's public IP addresses, separated by commas. Site domains point their A and AAAA
# records at them; without it the admin offers only a CNAME record to the admin host.
# WEBCRAFT_PUBLIC_ADDRESSES=203.0.113.10,2001:db8::10

# Optional: the proxies whose X-Forwarded-For is believed (IP addresses and ranges, "private", "none"
# or "railway"). Unset, it follows WEBCRAFT_EDGE. In development nothing is in front of the web process.
# WEBCRAFT_TRUSTED_PROXIES=

# The web process's port.
PORT=3000

# Optional: the folder uploaded Media is kept in while the Install's storage is local disk (Install
# settings › Storage). An absolute path; web and worker must share it. `bun run dev` uses ./storage.
# WEBCRAFT_STORAGE_DIR=/var/lib/webcraft/storage

# Optional: the Backups folder, where Backups go while Install settings › Backups says "Backups folder"
# and where `webcraft admin backup` writes. An absolute path; on a server, a volume the worker and the
# migrate step share. `bun run dev` uses ./backups.
# WEBCRAFT_BACKUP_DIR=/var/lib/webcraft/backups

# Optional: where the update check reads the newest WebCraft release (an https address), or off to turn
# the check off. Unset, the project's own release feed. It sends nothing about the Install.
# WEBCRAFT_UPDATE_FEED=off

# Optional: a file of address ranges and their countries (first address, last address, country code,
# one range per line), which Site analytics counts visits by country with. Without it every country
# is unknown. See docs/development.md › Site analytics.
# WEBCRAFT_COUNTRY_FILE=/var/lib/webcraft/countries.csv

# The Master key: it encrypts every stored secret (SMTP passwords, AI keys, Webhook secrets). At
# least 32 characters; web and worker refuse to start without it. Make one with
#   openssl rand -base64 32
# and keep a copy outside this machine: without it the stored secrets can't be read. Never reuse
# a key from another Install, and never commit one.
WEBCRAFT_SECRET_KEY=
