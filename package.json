{
  "name": "webcraft",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "varlock": "1.23.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@orpc/server": "^1.15.6",
      "@orpc/client": "^1.15.6",
      "@orpc/openapi": "^1.15.6",
      "@orpc/zod": "^1.15.6",
      "better-auth": "1.7.12",
      "drizzle-orm": "1.0.0-rc.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @webcraft/db --",
    "db:studio": "turbo run db:studio -F @webcraft/db --",
    "db:generate": "turbo run db:generate -F @webcraft/db --",
    "db:migrate": "turbo run db:migrate -F @webcraft/db --",
    "db:start": "turbo run db:start -F @webcraft/db --",
    "db:watch": "turbo run db:watch -F @webcraft/db --",
    "db:stop": "turbo run db:stop -F @webcraft/db --",
    "db:down": "turbo run db:down -F @webcraft/db --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/web && bun run auth:generate",
    "check": "biome check --write ."
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.4.1",
    "@webcraft/config": "workspace:*",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
