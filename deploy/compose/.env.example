# WebCraft with Docker Compose: copy to .env next to docker-compose.yml and fill it in.
# Every step is in docs/deploy/compose.md.

# The WebCraft version to run: an exact image tag (ghcr.io/flyingwebie/webcraft-web and -worker).
# `main` follows the main branch until the first release; then pin a release such as 1.0.0.
WEBCRAFT_VERSION=main

# The admin's hostname (no scheme, port or path). Point its DNS A/AAAA records at this server.
WEBCRAFT_ADMIN_HOST=admin.example.com

# Optional: the domain Staging addresses sit under (<site slug>.sites.example.com). Point a wildcard
# DNS record (*.sites.example.com) at this server.
WEBCRAFT_SITES_DOMAIN=sites.example.com

# Optional but recommended: this server's public IP addresses, separated by commas. Site domains point
# their A and AAAA records at them.
WEBCRAFT_PUBLIC_ADDRESSES=

# The Master key: it encrypts every stored secret. Make it once with
#   openssl rand -base64 32
# and keep a copy outside this server (a password manager): without it the secrets can't be read, and it
# is never in a Backup. Never change it here without `webcraft admin rotate-key`.
WEBCRAFT_SECRET_KEY=

# The Postgres password. Make it with `openssl rand -hex 32` (it goes in a connection string, so no
# symbols).
POSTGRES_PASSWORD=

# Optional: the proxies whose X-Forwarded-For is believed. Unset, the private ranges, where Caddy
# reaches the web process. See docs/deploy/README.md, "Visitors' addresses".
# WEBCRAFT_TRUSTED_PROXIES=

# Optional: extra global options for Caddy, such as an email for the certificate authority:
# WEBCRAFT_CADDY_OPTIONS=email you@agency.example

# Optional: other host ports for Caddy, when something else on the server has 80 and 443.
# WEBCRAFT_HTTP_PORT=80
# WEBCRAFT_HTTPS_PORT=443
